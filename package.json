{
  "name": "thesitch",
  "version": "0.6.0",
  "description": "A cyberpunk city for your engineering contributions",
  "private": true,
  "main": "out/main/index.js",
  "author": "TheSitch",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "check": "biome check src tests electron.vite.config.ts",
    "format": "biome check --write src tests electron.vite.config.ts",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "package": "pnpm build && electron-builder",
    "package:dir": "pnpm build && electron-builder --dir",
    "test:worker": "pnpm build && node scripts/run-worker-smoke.cjs",
    "package:zip": "pnpm build && node scripts/package-zip.cjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.9",
    "jsdom": "25.0.1"
  },
  "build": {
    "appId": "app.thesitch.desktop",
    "productName": "TheSitch",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "TheSitch \u00b7 Neon City"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.iconset/icon_512x512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "icon": "build/icon.iconset/icon_512x512.png"
    }
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
